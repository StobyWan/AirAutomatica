# Packaged defaults: mock telemetry for reliable first boot (no FC or serial required).
# LOCAL_LLM_PROVIDER: when unset, app discovers Ollama at startup and uses it if ready,
# otherwise falls back to mock. Set explicitly to override (e.g. LOCAL_LLM_PROVIDER=ollama).
TELEMETRY_BACKEND=mock
# LOCAL_LLM_PROVIDER=mock  # Uncomment to force mock; omit to use discovery (ollama if ready)
CAMERA_RECORDING_MODE=manual

# API (bind all interfaces for dashboard access)
API_HOST=0.0.0.0
API_PORT=8000

# Override when switching to real hardware (example):
# TELEMETRY_BACKEND=serial
# SERIAL_PORT=/dev/ttyUSB0
# SERIAL_BAUD=921600
# LOCAL_LLM_PROVIDER=ollama
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=gemma3:1b
# OLLAMA_NUM_THREAD=4
# OLLAMA_REQUIRED=0  # If 1, startup fails when Ollama not ready (default: degraded mode)
# CAMERA_RECORDING_MODE=auto
# CAMERA_RECORDING_DISARM_DEBOUNCE_SEC=2.5  # seconds armed=False must persist before auto-stop (reduces false stops from telemetry jitter)

# Optional overrides (defaults work with system user)
# SQLITE_DB_PATH=/var/lib/airautomatica/.airautomatica/airautomatica.db
# Explicit recordings path for systemd service (avoids ~ expansion issues)
AIRAUTOMATICA_RECORDINGS_DIR=/var/lib/airautomatica/.airautomatica/recordings

# Debug: set LOG_LEVEL=DEBUG for verbose logs (journalctl -u airautomatica -f)
# LOG_LEVEL=DEBUG
