# Packaged defaults: mock mode for reliable first boot (no FC, serial, or Ollama required)
TELEMETRY_BACKEND=mock
LOCAL_LLM_PROVIDER=mock
CAMERA_RECORDING_MODE=manual

# API (bind all interfaces for dashboard access)
API_HOST=0.0.0.0
API_PORT=8000

# Override when switching to real hardware (example):
# TELEMETRY_BACKEND=serial
# SERIAL_PORT=/dev/ttyUSB0
# SERIAL_BAUD=921600
# LOCAL_LLM_PROVIDER=ollama
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=gemma3:1b
# OLLAMA_NUM_THREAD=4
# CAMERA_RECORDING_MODE=auto

# Optional overrides (defaults work with system user)
# SQLITE_DB_PATH=/var/lib/airautomatica/.airautomatica/airautomatica.db
# AIRAUTOMATICA_RECORDINGS_DIR=/var/lib/airautomatica/.airautomatica/recordings
