#!/bin/sh
set -e

APP_USER="airautomatica"
OPT_DIR="/opt/airautomatica"
VAR_DIR="/var/lib/airautomatica"
ETC_DIR="/etc/airautomatica"
SERVICE_NAME="airautomatica"

# Create system user if missing
if ! getent passwd "$APP_USER" >/dev/null 2>&1; then
  useradd --system --home "$VAR_DIR" --shell /usr/sbin/nologin "$APP_USER"
fi

# Create directories
mkdir -p "$VAR_DIR" "$ETC_DIR" "$VAR_DIR/.airautomatica/recordings"

# Add groups for device access: dialout (serial), video (camera), render (GPU/DMA, if present)
usermod -aG dialout "$APP_USER" 2>/dev/null || true
usermod -aG video "$APP_USER" 2>/dev/null || true
if getent group render >/dev/null 2>&1; then
  usermod -aG render "$APP_USER" 2>/dev/null || true
fi

# Install env template only if not present
if [ ! -f "$ETC_DIR/airautomatica.env" ]; then
  if [ -f "$OPT_DIR/airautomatica.env.example" ]; then
    cp "$OPT_DIR/airautomatica.env.example" "$ETC_DIR/airautomatica.env"
  fi
fi

# Create or validate venv and install wheel (no prebuilt venv in package)
# Validate: both python and pip must exist and be executable (broken upgrades may leave incomplete venv)
venv_valid=false
if [ -d "$OPT_DIR/venv" ] && [ -x "$OPT_DIR/venv/bin/python" ] && [ -x "$OPT_DIR/venv/bin/pip" ]; then
  venv_valid=true
fi

if [ "$venv_valid" = true ]; then
  echo "airautomatica postinst: reusing existing venv"
  "$OPT_DIR/venv/bin/pip" install --upgrade "$OPT_DIR/wheels"/airautomatica-*.whl
else
  if [ -d "$OPT_DIR/venv" ]; then
    echo "airautomatica postinst: venv broken or incomplete, rebuilding"
    rm -rf "$OPT_DIR/venv"
  else
    echo "airautomatica postinst: creating venv"
  fi
  python3 -m venv "$OPT_DIR/venv"
  "$OPT_DIR/venv/bin/pip" install --upgrade pip
  "$OPT_DIR/venv/bin/pip" install "$OPT_DIR/wheels"/airautomatica-*.whl
fi

# Clear stale bytecode and compile fresh so systemd runs current code
SITE_PKG="$("$OPT_DIR/venv/bin/python" -c "import site; print(site.getsitepackages()[0])" 2>/dev/null)" || true
if [ -n "$SITE_PKG" ] && [ -d "$SITE_PKG/airautomatica" ]; then
  APPDIR="$SITE_PKG/airautomatica"
  find "$APPDIR" -type d -name __pycache__ -print0 2>/dev/null | xargs -0 rm -rf 2>/dev/null || true
  find "$APPDIR" -type f -name "*.pyc" -delete 2>/dev/null || true
  echo "airautomatica postinst: stale bytecode cache cleared"
  "$OPT_DIR/venv/bin/python" -m compileall -q "$APPDIR" 2>/dev/null || true
  echo "airautomatica postinst: fresh bytecode compiled"
fi

# Set ownership
chown -R "$APP_USER:$APP_USER" "$OPT_DIR" "$VAR_DIR"

# Enable service (do not start automatically on install; let operator start)
systemctl daemon-reload
systemctl enable "$SERVICE_NAME"
