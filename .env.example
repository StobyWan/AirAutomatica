# Telemetry
TELEMETRY_BACKEND=mock
# SERIAL_PORT: /dev/ttyUSB0 default (CP2102/FTDI); /dev/ttyACM0 for native USB
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=921600

# AI provider: mock, ollama, or lmstudio (legacy). Use mock for first run (no setup).
LOCAL_LLM_PROVIDER=mock
# Legacy: AI_MODE and AI_BACKEND still accepted when loading; mapped to canonical keys.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma3:1b
LOCAL_LLM_TIMEOUT=30
# Mission logic: min confidence to persist (0-1); duplicate window (seconds)
AI_MIN_CONFIDENCE=0.5
AI_DUPLICATE_WINDOW_SEC=30
# AI HAT: enabled alongside local LLM (mock/ollama), not instead of it
AI_HAT_ENABLED=0
# Legacy: AI_MODE=aihat also enables AI HAT with mock as base
AIHAT_MODEL_NAME=default
# Placeholder: AI HAT+ uses PCIe; HailoRT auto-discovers. Unused until real integration.
AIHAT_DEVICE=auto

# API
API_HOST=0.0.0.0
API_PORT=8000

# Persistence
SQLITE_DB_PATH=~/.airautomatica/airautomatica.db
