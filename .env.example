# Telemetry
TELEMETRY_BACKEND=mock
# SERIAL_PORT: /dev/ttyUSB0 for CP2102/FTDI; /dev/ttyACM0 for native USB
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=921600

# AI (AI_MODE or AI_BACKEND for legacy)
AI_MODE=lmstudio
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=local-model
LM_STUDIO_TIMEOUT=30
# Mission logic: min confidence to persist (0-1); duplicate window (seconds)
AI_MIN_CONFIDENCE=0.5
AI_DUPLICATE_WINDOW_SEC=30
AIHAT_MODEL_NAME=default
# Placeholder: AI HAT+ uses PCIe; HailoRT auto-discovers. Unused until real integration.
AIHAT_DEVICE=auto

# API
API_HOST=0.0.0.0
API_PORT=8000

# Persistence
SQLITE_DB_PATH=~/.airautomatica/airautomatica.db
